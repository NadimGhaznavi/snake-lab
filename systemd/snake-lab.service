[Unit]
Description=Snake Lab AI simulations
Requires=mariadb.service
After=network.target mariadb.service

[Service]
Type=simple
WorkingDirectory=/opt/prod/snakelab
ExecStart=/opt/prod/snakelab/venv/bin/python -m snakelab.server
Restart=on-failure
RestartSec=5
User=snake-lab
Group=snake-lab
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/prod/snakelab/logs

[Install]
WantedBy=multi-user.target
