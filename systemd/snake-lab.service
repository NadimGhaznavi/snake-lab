[Unit]
Description=SnakeLab AI simulation server
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/snake-lab/app
ExecStart=/opt/snake-lab/venv/bin/python -m snake_lab.server
Restart=on-failure
RestartSec=5
User=snake-lab
Group=snake-lab
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/snake-lab/logs

[Install]
WantedBy=multi-user.target
