[Unit]
Description=SnakeLab AI simulation server
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/snake-lab
ExecStart=/opt/snake-lab/venv/bin/python -m snake_lab.server
Restart=on-failure
RestartSec=5
DynamicUser=yes
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
